{
  "name": "maqar-ai-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @maqar/web",
    "dev:web": "npm run dev -w @maqar/web",
    "dev:api": "npm run start:dev -w @maqar/api",
    "build": "npm run build -w @maqar/web && npm run build -w @maqar/api",
    "lint": "npm run lint -w @maqar/web",
    "db:generate": "npm run generate -w @maqar/database",
    "db:push": "npm run push -w @maqar/database",
    "db:migrate:deploy": "npm run migrate:deploy -w @maqar/database",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:production": "node scripts/production-live-smoke.mjs",
    "gemini:models": "node scripts/gemini-models.mjs",
    "gemini:smoke": "node scripts/gemini-live-smoke.mjs",
    "smoke:imports": "node scripts/import-live-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/platform-express": "11.1.29",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1"
  }
}
