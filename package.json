{
  "name": "maqar-ai-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @maqar/web",
    "dev:web": "npm run dev -w @maqar/web",
    "dev:api": "npm run start:dev -w @maqar/api",
    "build": "npm run build -w @maqar/web && npm run build -w @maqar/api",
    "lint": "npm run lint -w @maqar/web",
    "db:generate": "npm run generate -w @maqar/database",
    "db:push": "npm run push -w @maqar/database",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:production": "node scripts/production-live-smoke.mjs",
    "ai:smoke": "node scripts/ai-live-smoke.mjs",
    "smoke:imports": "node scripts/import-live-smoke.mjs",
    "smoke:typed-import": "node scripts/typed-import-live-smoke.mjs",
    "smoke:real-estate-data": "node scripts/real-estate-data-smoke.mjs",
    "smoke:r2-storage": "node scripts/r2-storage-smoke.mjs",
    "smoke:maps": "node scripts/maps-live-smoke.mjs",
    "smoke:ai-search": "node scripts/ai-search-live-smoke.mjs",
    "admin:path:generate": "node scripts/generate-admin-path.mjs"
  },
  "dependencies": {
    "@nestjs/platform-express": "11.1.29",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1"
  }
}
