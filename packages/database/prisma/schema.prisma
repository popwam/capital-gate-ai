generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LocationType {
  COUNTRY
  GOVERNORATE
  CITY
  AREA
  SUBAREA
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  UNAVAILABLE
  CONTACT_SALES
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportStatus {
  UPLOADED
  ANALYZING
  NEEDS_INPUT
  READY
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

enum ImportUnitOperation {
  CREATED
  UPDATED
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
  BLOCKING
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MediaType {
  IMAGE
  FLOOR_PLAN
  MASTER_PLAN
  VIDEO
  MAP
}

enum DocumentType {
  BROCHURE
  PAYMENT_PLAN
  KNOWLEDGE_SOURCE
  OTHER
}

enum LeadIntent {
  INQUIRY
  VIEWING
  PURCHASE
  RESERVATION
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  FOLLOW_UP
  VIEWING_REQUESTED
  NEGOTIATING
  WON
  LOST
}

model Location {
  id                String                      @id @default(cuid())
  type              LocationType
  name              String
  canonicalName     String?
  nameAr            String?
  nameEn            String?
  formattedAddress  String?
  source            String?
  slug              String                      @unique
  parentId          String?
  parent            Location?                   @relation("LocationTree", fields: [parentId], references: [id])
  children          Location[]                  @relation("LocationTree")
  latitude          Decimal?                    @db.Decimal(10, 7)
  longitude         Decimal?                    @db.Decimal(10, 7)
  googlePlaceId     String?
  aliases           LocationAlias[]
  distancesFrom     LocationDistance[]          @relation("DistanceFrom")
  distancesTo       LocationDistance[]          @relation("DistanceTo")
  projects          Project[]
  importSheets      ImportSheet[]
  portfolioProjects DeveloperProjectPortfolio[]
  projectLandmarks  ProjectLandmark[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([parentId, type])
}

model LocationAlias {
  id              String         @id @default(cuid())
  locationId      String
  location        Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  value           String
  normalizedValue String
  language        String?
  approvalStatus  ApprovalStatus @default(APPROVED)
  createdAt       DateTime       @default(now())

  @@unique([locationId, normalizedValue])
  @@index([normalizedValue])
}

model LocationDistance {
  id                String     @id @default(cuid())
  fromLocationId    String
  toLocationId      String
  from              Location   @relation("DistanceFrom", fields: [fromLocationId], references: [id])
  to                Location   @relation("DistanceTo", fields: [toLocationId], references: [id])
  distanceKm        Decimal    @db.Decimal(8, 2)
  estimatedMinutes  Int?
  distanceType      String     @default("ADMIN_VERIFIED")
  notes             String?
  isBidirectional   Boolean    @default(true)
  verifiedAt        DateTime?
  verifiedByAdminId String?
  verifiedBy        AdminUser? @relation(fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  @@unique([fromLocationId, toLocationId])
}

model Developer {
  id                             String                      @id @default(cuid())
  name                           String
  slug                           String                      @unique
  description                    String?
  canonicalName                  String?
  nameAr                         String?
  nameEn                         String?
  shortName                      String?
  brandName                      String?
  logoUrl                        String?
  coverImageUrl                  String?
  website                        String?
  foundedYear                    Int?
  headquarters                   String?
  country                        String?
  developerType                  String?
  salesPhone                     String?
  email                          String?
  socialLinks                    Json?
  shortDescriptionAr             String?
  shortDescriptionEn             String?
  fullDescriptionAr              String?
  fullDescriptionEn              String?
  yearsInMarket                  Int?
  deliveredProjectsCount         Int?
  projectsUnderConstructionCount Int?
  geographicFocus                String[]
  specialties                    String[]
  sourceMetadata                 Json?
  projects                       Project[]
  units                          Unit[]
  media                          Media[]
  documents                      Document[]
  imports                        DataImport[]
  importSheets                   ImportSheet[]
  portfolioProjects              DeveloperProjectPortfolio[]
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
}

model Project {
  id                         String                    @id @default(cuid())
  developerId                String
  developer                  Developer                 @relation(fields: [developerId], references: [id])
  locationId                 String?
  location                   Location?                 @relation(fields: [locationId], references: [id])
  name                       String
  canonicalName              String?
  nameAr                     String?
  nameEn                     String?
  slug                       String                    @unique
  shortDescription           String?
  description                String?
  shortDescriptionAr         String?
  shortDescriptionEn         String?
  fullDescriptionAr          String?
  fullDescriptionEn          String?
  adminStatus                String                    @default("DRAFT")
  launchDate                 DateTime?
  launchYear                 Int?
  officialWebsite            String?
  formattedAddress           String?
  googlePlaceId              String?
  latitude                   Decimal?                  @db.Decimal(10, 7)
  longitude                  Decimal?                  @db.Decimal(10, 7)
  boundaryGeoJson            Json?
  boundarySource             String?
  boundaryConfirmedAt        DateTime?
  boundaryConfirmedByAdminId String?
  boundaryConfirmedBy        AdminUser?                @relation("ProjectBoundaryConfirmation", fields: [boundaryConfirmedByAdminId], references: [id], onDelete: SetNull)
  masterPlanCalibration      Json?
  projectStatus              String?
  projectType                String?
  projectTypes               String[]                  @default([])
  deliveryInformation        String?
  deliveryStatus             String?
  deliveryStatuses           String[]                  @default([])
  deliveryDate               DateTime?
  deliveryYear               Int?
  finishingOptions           String[]
  totalLandArea              Decimal?                  @db.Decimal(14, 2)
  builtUpPercentage          Decimal?                  @db.Decimal(7, 4)
  numberOfPhases             Int?
  totalUnits                 Int?
  densityDescription         String?
  gatedCommunity             Boolean?
  unitTypes                  String[]
  minArea                    Decimal?                  @db.Decimal(10, 2)
  maxArea                    Decimal?                  @db.Decimal(10, 2)
  minBedrooms                Int?
  maxBedrooms                Int?
  priceSummary               String?
  paymentSummary             String?
  maintenanceSummary         String?
  clubFeesSummary            String?
  customerFit                String[]
  sourceMetadata             Json?
  units                      Unit[]
  knowledge                  ProjectKnowledge[]
  knowledgeItems             ProjectKnowledgeItem[]
  media                      Media[]
  mediaRules                 UnitMediaRule[]
  documents                  Document[]
  imports                    DataImport[]
  importSheets               ImportSheet[]
  paymentPlans               PaymentPlan[]
  amenities                  ProjectAmenity[]
  gates                      ProjectGate[]
  zones                      ProjectZone[]
  buildings                  ProjectBuilding[]
  phases                     ProjectPhase[]
  phaseAliases               ProjectPhaseAlias[]
  marketProfiles             MarketProfile[]
  investmentProfile          ProjectInvestmentProfile?
  landmarks                  ProjectLandmark[]
  competitorsFrom            ProjectCompetitor[]       @relation("CompetitorFrom")
  competitorsTo              ProjectCompetitor[]       @relation("CompetitorTo")
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@unique([developerId, name])
  @@index([locationId])
}

model ProjectKnowledge {
  id               String         @id @default(cuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalText     String
  sourceDocumentId String?
  structured       Json?
  approvalStatus   ApprovalStatus @default(PENDING)
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ProjectKnowledgeItem {
  id                String         @id @default(cuid())
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category          String
  content           String
  sourceDocumentId  String?
  sourceDocument    Document?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  sourceText        String?
  confidence        Decimal?       @db.Decimal(4, 3)
  approvalStatus    ApprovalStatus @default(PENDING)
  approvedByAdminId String?
  approvedBy        AdminUser?     @relation(fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([projectId, approvalStatus, category])
}

model ProjectPhase {
  id                     String              @id @default(cuid())
  projectId              String
  project                Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code                   String?
  name                   String
  nameAr                 String?
  nameEn                 String?
  sortOrder              Int                 @default(0)
  launchYear             Int?
  deliveryYear           Int?
  status                 String?
  deliveryStatuses       String[]            @default([])
  projectTypes           String[]            @default([])
  constructionPercentage Decimal?            @db.Decimal(7, 4)
  unitTypes              String[]            @default([])
  finishingOptions       String[]            @default([])
  customerFit            String[]            @default([])
  minArea                Decimal?            @db.Decimal(10, 2)
  maxArea                Decimal?            @db.Decimal(10, 2)
  minBedrooms            Int?
  maxBedrooms            Int?
  descriptionAr          String?
  descriptionEn          String?
  deliveryNotesAr        String?
  deliveryNotesEn        String?
  masterPlanPolygon      Json?
  sourceMetadata         Json?
  units                  Unit[]
  gates                  ProjectGate[]
  zones                  ProjectZone[]
  buildings              ProjectBuilding[]
  media                  Media[]
  mediaRules             UnitMediaRule[]
  documents              Document[]
  paymentPlans           PaymentPlan[]
  marketProfiles         MarketProfile[]
  importSheets           ImportSheet[]
  aliases                ProjectPhaseAlias[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
  @@index([deliveryYear, status])
}

model ProjectPhaseAlias {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId         String
  phase           ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  value           String
  normalizedValue String
  source          String       @default("IMPORT")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([projectId, normalizedValue])
  @@index([phaseId])
}

model MarketProfile {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId         String?
  phase           ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  segment         String
  propertyUse     String        @default("RESIDENTIAL")
  suitability     String?
  demand          String?
  yieldMin        Decimal?      @db.Decimal(7, 4)
  yieldMax        Decimal?      @db.Decimal(7, 4)
  liquidity       String?
  targetCustomers String[]      @default([])
  advantages      String[]      @default([])
  risks           String[]      @default([])
  metrics         Json?
  notes           String?
  source          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId, segment, propertyUse])
  @@index([phaseId, segment])
  @@index([unitId, segment])
}

model Unit {
  id                           String                   @id @default(cuid())
  externalUnitId               String
  developerId                  String
  developer                    Developer                @relation(fields: [developerId], references: [id])
  projectId                    String
  project                      Project                  @relation(fields: [projectId], references: [id])
  phase                        String?
  phaseId                      String?
  phaseRef                     ProjectPhase?            @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  cluster                      String?
  building                     String?
  floor                        String?
  unitType                     String?
  unitSubType                  String?
  bedrooms                     Int?
  bathrooms                    Int?
  builtUpArea                  Decimal?                 @db.Decimal(10, 2)
  landArea                     Decimal?                 @db.Decimal(10, 2)
  gardenArea                   Decimal?                 @db.Decimal(10, 2)
  roofArea                     Decimal?                 @db.Decimal(10, 2)
  terraceArea                  Decimal?                 @db.Decimal(10, 2)
  price                        Decimal?                 @db.Decimal(16, 2)
  currency                     String?
  status                       UnitStatus               @default(AVAILABLE)
  isResale                     Boolean                  @default(false)
  deliveryDate                 DateTime?
  deliveryYears                Decimal?                 @db.Decimal(4, 1)
  finishingType                String?
  downPayment                  Decimal?                 @db.Decimal(16, 2)
  installmentYears             Decimal?                 @db.Decimal(4, 1)
  installmentAmount            Decimal?                 @db.Decimal(16, 2)
  maintenance                  Decimal?                 @db.Decimal(16, 2)
  clubFees                     Decimal?                 @db.Decimal(16, 2)
  discount                     Decimal?                 @db.Decimal(10, 2)
  offerText                    String?
  latitude                     Decimal?                 @db.Decimal(10, 7)
  longitude                    Decimal?                 @db.Decimal(10, 7)
  masterPlanX                  Decimal?                 @db.Decimal(7, 6)
  masterPlanY                  Decimal?                 @db.Decimal(7, 6)
  masterPlanLocationStatus     String                   @default("UNLOCATED")
  masterPlanLocationSource     String?
  masterPlanConfidence         Decimal?                 @db.Decimal(4, 3)
  masterPlanConfirmedAt        DateTime?
  masterPlanConfirmedByAdminId String?
  masterPlanConfirmedBy        AdminUser?               @relation("MasterPlanUnitConfirmation", fields: [masterPlanConfirmedByAdminId], references: [id], onDelete: SetNull)
  internalLocationDescription  String?
  projectZoneId                String?
  projectZone                  ProjectZone?             @relation(fields: [projectZoneId], references: [id], onDelete: SetNull)
  projectBuildingId            String?
  projectBuilding              ProjectBuilding?         @relation(fields: [projectBuildingId], references: [id], onDelete: SetNull)
  proximities                  UnitProximity[]
  sourceImportId               String?
  sourceImport                 DataImport?              @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  archivedAt                   DateTime?
  sourceMetadata               Json?
  importChanges                ImportUnitChange[]
  correctionChanges            ImportCorrectionChange[]
  availabilityUpdatedAt        DateTime                 @default(now())
  priceHistory                 UnitPriceHistory[]
  paymentPlans                 PaymentPlan[]
  offers                       Offer[]
  media                        Media[]
  marketProfiles               MarketProfile[]
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@unique([developerId, projectId, externalUnitId])
  @@index([projectId, status, price, bedrooms])
  @@index([isResale, status])
  @@index([projectZoneId])
  @@index([projectBuildingId])
  @@index([phaseId])
}

model ProjectGate {
  id                 String          @id @default(cuid())
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId            String?
  phase              ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  code               String?
  name               String
  nameAr             String?
  nameEn             String?
  gateNumber         Int?
  latitude           Decimal?        @db.Decimal(10, 7)
  longitude          Decimal?        @db.Decimal(10, 7)
  masterPlanX        Decimal?        @db.Decimal(7, 6)
  masterPlanY        Decimal?        @db.Decimal(7, 6)
  googlePlaceId      String?
  isMain             Boolean         @default(false)
  isActive           Boolean         @default(true)
  notes              String?
  locationSource     String?
  confirmedAt        DateTime?
  confirmedByAdminId String?
  confirmedBy        AdminUser?      @relation("ProjectGateConfirmation", fields: [confirmedByAdminId], references: [id], onDelete: SetNull)
  proximities        UnitProximity[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([projectId, name])
  @@index([projectId, isActive])
  @@index([phaseId])
}

model ProjectZone {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId           String?
  phase             ProjectPhase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  masterPlanPolygon Json?
  code              String?
  name              String
  nameAr            String?
  nameEn            String?
  notes             String?
  units             Unit[]
  buildings         ProjectBuilding[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([phaseId])
}

model ProjectBuilding {
  id                           String        @id @default(cuid())
  projectId                    String
  project                      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId                      String?
  phase                        ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  zoneId                       String?
  zone                         ProjectZone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  code                         String?
  name                         String
  nameAr                       String?
  nameEn                       String?
  latitude                     Decimal?      @db.Decimal(10, 7)
  longitude                    Decimal?      @db.Decimal(10, 7)
  masterPlanX                  Decimal?      @db.Decimal(7, 6)
  masterPlanY                  Decimal?      @db.Decimal(7, 6)
  masterPlanPolygon            Json?
  masterPlanLocationSource     String?
  masterPlanConfirmedAt        DateTime?
  masterPlanConfirmedByAdminId String?
  masterPlanConfirmedBy        AdminUser?    @relation("MasterPlanBuildingConfirmation", fields: [masterPlanConfirmedByAdminId], references: [id], onDelete: SetNull)
  notes                        String?
  units                        Unit[]
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  @@unique([projectId, name])
  @@index([projectId, zoneId])
  @@index([phaseId])
}

model UnitProximity {
  id             String           @id @default(cuid())
  unitId         String
  unit           Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  targetType     String
  gateId         String?
  gate           ProjectGate?     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  amenityId      String?
  amenity        Amenity?         @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  landmarkId     String?
  landmark       ProjectLandmark? @relation(fields: [landmarkId], references: [id], onDelete: Cascade)
  distanceMeters Int?
  walkingMinutes Int?
  drivingMinutes Int?
  source         String?
  verified       Boolean          @default(false)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([unitId, targetType])
  @@index([gateId])
  @@index([amenityId])
  @@index([landmarkId])
}

model UnitPriceHistory {
  id          String      @id @default(cuid())
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  price       Decimal     @db.Decimal(16, 2)
  currency    String
  effectiveAt DateTime    @default(now())
  importId    String?
  import      DataImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([unitId, effectiveAt])
}

model PaymentPlan {
  id                         String        @id @default(cuid())
  phaseId                    String?
  phase                      ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  unitId                     String?
  unit                       Unit?         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  projectId                  String?
  project                    Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                       String?
  downPayment                Decimal?      @db.Decimal(16, 2)
  installmentYears           Decimal?      @db.Decimal(4, 1)
  installmentAmount          Decimal?      @db.Decimal(16, 2)
  durationMonths             Int?
  downPaymentAmount          Decimal?      @db.Decimal(16, 2)
  downPaymentPercent         Decimal?      @db.Decimal(7, 4)
  totalPrice                 Decimal?      @db.Decimal(16, 2)
  totalPriceOverride         Decimal?      @db.Decimal(16, 2)
  discountAmount             Decimal?      @db.Decimal(16, 2)
  discountPercent            Decimal?      @db.Decimal(7, 4)
  installmentFrequency       String?
  currency                   String?
  maintenanceAmount          Decimal?      @db.Decimal(16, 2)
  maintenancePercent         Decimal?      @db.Decimal(7, 4)
  planType                   String        @default("INSTALLMENT")
  reservationAmount          Decimal?      @db.Decimal(16, 2)
  durationValue              Int?
  durationUnit               String?
  installmentEveryValue      Int?
  installmentEveryUnit       String?
  firstInstallmentTiming     String?
  firstInstallmentAfterValue Int?
  firstInstallmentAfterUnit  String?
  distributionMode           String        @default("EQUAL")
  percentageSchedule         Json?
  validFrom                  DateTime?
  validTo                    DateTime?
  sourceImportId             String?
  sourceImport               DataImport?   @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  sourceMetadata             Json?
  notes                      String?
  isActive                   Boolean       @default(true)

  @@index([unitId, durationMonths])
  @@index([projectId, isActive])
  @@index([phaseId, isActive])
  @@index([sourceImportId])
}

model Offer {
  id             String    @id @default(cuid())
  unitId         String
  unit           Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  discountAmount Decimal?  @db.Decimal(16, 2)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
}

model Media {
  id              String          @id @default(cuid())
  phaseId         String?
  phase           ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  type            MediaType
  url             String
  altText         String?
  altTextAr       String?
  altTextEn       String?
  caption         String?
  storageKey      String?
  isCover         Boolean         @default(false)
  developerId     String?
  developer       Developer?      @relation(fields: [developerId], references: [id])
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id])
  unitId          String?
  unit            Unit?           @relation(fields: [unitId], references: [id])
  sortOrder       Int             @default(0)
  purpose         String          @default("GALLERY")
  assignmentRules UnitMediaRule[]
  createdAt       DateTime        @default(now())
}

model UnitMediaRule {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId        String?
  phase          ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  mediaId        String
  media          Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  unitType       String?
  unitSubType    String?
  bedrooms       Int?
  bathrooms      Int?
  minBuiltUpArea Decimal?      @db.Decimal(10, 2)
  maxBuiltUpArea Decimal?      @db.Decimal(10, 2)
  priority       Int           @default(0)
  isActive       Boolean       @default(true)
  label          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([projectId, phaseId, isActive])
  @@index([bedrooms, bathrooms])
  @@index([minBuiltUpArea, maxBuiltUpArea])
  @@index([mediaId])
}

model Document {
  id             String                 @id @default(cuid())
  phaseId        String?
  phase          ProjectPhase?          @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  type           DocumentType
  name           String
  url            String
  mimeType       String
  originalText   String?
  storageKey     String?
  language       String?
  source         String?
  validFrom      DateTime?
  validTo        DateTime?
  developerId    String?
  developer      Developer?             @relation(fields: [developerId], references: [id])
  projectId      String?
  project        Project?               @relation(fields: [projectId], references: [id])
  knowledgeItems ProjectKnowledgeItem[]
  createdAt      DateTime               @default(now())
}

model DataImport {
  id                String             @id @default(cuid())
  name              String?
  fileName          String
  fileHash          String
  fileUrl           String?
  developerId       String?
  developer         Developer?         @relation(fields: [developerId], references: [id])
  projectId         String?
  project           Project?           @relation(fields: [projectId], references: [id])
  uploadedByAdminId String?
  uploadedBy        AdminUser?         @relation(fields: [uploadedByAdminId], references: [id], onDelete: SetNull)
  parentImportId    String?
  parentImport      DataImport?        @relation("ImportVersions", fields: [parentImportId], references: [id], onDelete: SetNull)
  versions          DataImport[]       @relation("ImportVersions")
  uploadedAt        DateTime           @default(now())
  status            ImportStatus       @default(UPLOADED)
  rowsDetected      Int                @default(0)
  rowsCreated       Int                @default(0)
  rowsUpdated       Int                @default(0)
  rowsRejected      Int                @default(0)
  rowsSkipped       Int                @default(0)
  rowsFailed        Int                @default(0)
  warnings          Json?
  missingUnitPolicy String             @default("LEAVE_UNCHANGED")
  completedAt       DateTime?
  cancelledAt       DateTime?
  rolledBackAt      DateTime?
  mappingConfig     Json?
  analysis          Json?
  preview           Json?
  units             Unit[]
  priceHistory      UnitPriceHistory[]
  issues            ImportIssue[]
  sheets            ImportSheet[]
  corrections       ImportCorrection[]
  unitChanges       ImportUnitChange[]
  paymentPlans      PaymentPlan[]

  @@index([fileHash])
}

model ImportSheet {
  id                    String             @id @default(cuid())
  importId              String
  import                DataImport         @relation(fields: [importId], references: [id], onDelete: Cascade)
  sheetName             String
  tableId               String?
  classification        String
  confidence            Int                @default(0)
  action                String             @default("IGNORE")
  headerRow             Int?
  startRow              Int?
  endRow                Int?
  rowsDetected          Int                @default(0)
  rowsCreated           Int                @default(0)
  rowsUpdated           Int                @default(0)
  projectId             String?
  project               Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  phaseId               String?
  phase                 ProjectPhase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  developerId           String?
  developer             Developer?         @relation(fields: [developerId], references: [id], onDelete: SetNull)
  locationId            String?
  location              Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  defaultCurrency       String?
  defaultUnitType       String?
  defaultIsResale       Boolean            @default(false)
  columns               Json?
  mappings              Json?
  mappingSources        Json?
  sourcePreview         Json?
  normalizedPreview     Json?
  mappingVersion        Int                @default(1)
  previewMappingVersion Int?
  importedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  unitChanges           ImportUnitChange[]
  corrections           ImportCorrection[]

  @@unique([importId, sheetName, tableId])
  @@index([importId, action])
  @@index([projectId])
  @@index([phaseId])
}

model ImportCorrection {
  id                String                   @id @default(cuid())
  importId          String
  import            DataImport               @relation(fields: [importId], references: [id], onDelete: Cascade)
  importSheetId     String
  importSheet       ImportSheet              @relation(fields: [importSheetId], references: [id], onDelete: Cascade)
  createdByAdminId  String?
  createdBy         AdminUser?               @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  status            String                   @default("DRAFT")
  oldMappings       Json
  proposedMappings  Json
  preview           Json?
  conflictDecisions Json?
  confirmedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  changes           ImportCorrectionChange[]

  @@index([importId, status])
  @@index([importSheetId])
}

model ImportCorrectionChange {
  id            String           @id @default(cuid())
  correctionId  String
  correction    ImportCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  beforeData    Json
  correctedData Json
  currentData   Json
  conflict      Boolean          @default(false)
  decision      String?
  appliedAt     DateTime?

  @@index([correctionId, conflict])
  @@index([unitId])
}

model ImportUnitChange {
  id             String              @id @default(cuid())
  importId       String
  import         DataImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  importSheetId  String?
  importSheet    ImportSheet?        @relation(fields: [importSheetId], references: [id], onDelete: SetNull)
  unitId         String?
  unit           Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  operation      ImportUnitOperation
  beforeData     Json?
  afterData      Json
  appliedAt      DateTime            @default(now())
  revertedAt     DateTime?
  conflictReason String?

  @@unique([importId, unitId])
  @@index([unitId, appliedAt])
  @@index([importSheetId])
}

model ImportMapping {
  id               String   @id @default(cuid())
  developerSlug    String?
  sourceColumn     String
  normalizedColumn String
  canonicalField   String
  confidence       Decimal? @db.Decimal(4, 3)
  approved         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([developerSlug, normalizedColumn])
}

model ImportValueMapping {
  id              String   @id @default(cuid())
  developerSlug   String
  canonicalField  String
  sourceValue     String
  normalizedValue String
  targetValue     String
  approved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([developerSlug, canonicalField, normalizedValue])
  @@index([canonicalField, normalizedValue])
}

model ImportIssue {
  id         String        @id @default(cuid())
  importId   String
  import     DataImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  severity   IssueSeverity
  field      String?
  rowNumber  Int?
  message    String
  inputType  String?
  options    Json?
  required   Boolean       @default(false)
  resolution Json?
  resolvedAt DateTime?

  @@index([importId, severity])
}

model AnonymousDevice {
  id             String         @id @default(cuid())
  hashedDeviceId String         @unique
  conversations  Conversation[]
  createdAt      DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
}

model Conversation {
  id                  String               @id @default(cuid())
  deviceId            String
  device              AnonymousDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  title               String?
  detectedLanguage    String?
  promptVariant       String               @default("control")
  nadimConversationId String?
  nadimConversation   NadimConversation?   @relation(fields: [nadimConversationId], references: [id], onDelete: SetNull)
  messages            Message[]
  state               ConversationState?
  leads               Lead[]
  trustAlerts         CustomerTrustAlert[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([deviceId, updatedAt])
  @@index([nadimConversationId])
}

model Customer {
  id                       String                    @id @default(cuid())
  name                     String?
  normalizedPhone          String?                   @unique
  normalizedEmail          String?                   @unique
  timezone                 String?
  leads                    Lead[]
  channelIdentities        CustomerChannelIdentity[]
  nadimConversations       NadimConversation[]
  propertyRequirements     PropertyRequirement[]
  followUpTasks            FollowUpTask[]
  conversationParticipants ConversationParticipant[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([createdAt])
}

model CustomerChannelIdentity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String
  externalId String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([channel, externalId])
  @@index([customerId, channel])
}

model AutomationActionExecution {
  id              String    @id @default(cuid())
  idempotencyKey  String    @unique
  actionType      String
  source          String
  requestHash     String
  requestPayload  Json
  responsePayload Json?
  status          String
  errorCode       String?
  entityType      String?
  entityId        String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([status, createdAt])
  @@index([entityType, entityId])
}

model NadimConversation {
  id                   String                    @id @default(cuid())
  customerId           String?
  customer             Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel              String
  externalUserId       String?
  locale               String?
  timezone             String?
  state                Json
  mode                 NadimConversationMode     @default(AI)
  summary              Json?
  customerContext      Json?
  pendingDeletion      Json?
  modeChangedAt        DateTime?
  humanModeSince       DateTime?
  lastHumanMessageAt   DateTime?
  activeRequirementId  String?
  activeRequirement    PropertyRequirement?      @relation("ActiveRequirement", fields: [activeRequirementId], references: [id], onDelete: SetNull)
  deletedAt            DateTime?
  turns                NadimTurn[]
  propertyRequirements PropertyRequirement[]     @relation("ConversationRequirements")
  followUpTasks        FollowUpTask[]
  participants         ConversationParticipant[]
  shareTokens          ConversationShareToken[]
  webConversations     Conversation[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([customerId, updatedAt])
  @@index([channel, externalUserId, updatedAt])
  @@index([mode, updatedAt])
  @@index([mode, lastHumanMessageAt, humanModeSince])
  @@index([activeRequirementId])
  @@index([deletedAt])
}

enum NadimConversationMode {
  AI
  HUMAN
  PAUSED
}

enum PropertyRequirementStatus {
  OPEN
  NEEDS_MATCH
  HUMAN_REVIEW
  MATCHED
  CLOSED
}

model PropertyRequirement {
  id                     String                    @id @default(cuid())
  customerId             String
  customer               Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId         String?
  conversation           NadimConversation?        @relation("ConversationRequirements", fields: [conversationId], references: [id], onDelete: SetNull)
  title                  String
  purpose                String?
  propertyType           String?
  locations              String[]                  @default([])
  preferredDevelopers    String[]                  @default([])
  preferredProjects      String[]                  @default([])
  bedrooms               Int?
  bathrooms              Int?
  areaMin                Decimal?                  @db.Decimal(12, 2)
  areaMax                Decimal?                  @db.Decimal(12, 2)
  budgetMin              Decimal?                  @db.Decimal(16, 2)
  budgetMax              Decimal?                  @db.Decimal(16, 2)
  currency               String?
  budgetOriginalAmount   Decimal?                  @db.Decimal(16, 2)
  budgetOriginalCurrency String?
  budgetNormalizedAmount Decimal?                  @db.Decimal(16, 2)
  budgetNormalizedCurrency String?
  fxRate                 Decimal?                  @db.Decimal(18, 8)
  fxAsOf                 DateTime?
  fxSource               String?
  paymentPreference      String?
  deliveryPreference     String?
  recentResultIds        String[]                  @default([])
  selectedUnitId         String?
  selectedProjectId      String?
  comparisonUnitIds      String[]                  @default([])
  notes                  String?
  status                 PropertyRequirementStatus @default(OPEN)
  activeForConversations NadimConversation[]       @relation("ActiveRequirement")
  followUpTasks          FollowUpTask[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([customerId, status, updatedAt])
  @@index([conversationId, status])
}

enum FollowUpTaskStatus {
  PENDING
  CLAIMED
  SENT
  FAILED
  CANCELLED
}

model FollowUpTask {
  id                    String               @id @default(cuid())
  customerId            String
  customer              Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId        String
  conversation          NadimConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  propertyRequirementId String?
  propertyRequirement   PropertyRequirement? @relation(fields: [propertyRequirementId], references: [id], onDelete: SetNull)
  channel               String
  outboundAddress       String
  dueAt                 DateTime
  timezone              String
  status                FollowUpTaskStatus   @default(PENDING)
  reason                String
  messageIntent         Json
  renderedMessage       String?
  dedupeKey             String?              @unique
  safeDuringHuman       Boolean              @default(false)
  claimedAt             DateTime?
  claimedBy             String?
  sentAt                DateTime?
  failedAt              DateTime?
  provider              String?
  providerMessageId     String?
  lastError             String?
  attempts              Int                  @default(0)
  maxAttempts           Int                  @default(3)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, dueAt])
  @@index([conversationId, status])
  @@index([claimedBy, claimedAt])
}

enum ConversationParticipantRole {
  OWNER
  MEMBER
}

enum ConversationParticipantStatus {
  ACTIVE
  LEFT
  REVOKED
}

model ConversationParticipant {
  id                 String                        @id @default(cuid())
  conversationId     String
  conversation       NadimConversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel            String
  externalUserId     String
  role               ConversationParticipantRole   @default(MEMBER)
  status             ConversationParticipantStatus @default(ACTIVE)
  displayMetadata    Json?
  joinedAt           DateTime                      @default(now())
  leftAt             DateTime?
  createdShareTokens ConversationShareToken[]      @relation("ShareTokenCreator")
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@unique([conversationId, channel, externalUserId])
  @@index([channel, externalUserId, status])
  @@index([customerId, status])
}

enum ConversationTokenType {
  WEB_SHARE
  WHATSAPP_HANDOFF
  WHATSAPP_JOIN
}

enum ConversationSharePermission {
  VIEW_AND_JOIN
}

model ConversationShareToken {
  id                     String                      @id @default(cuid())
  conversationId         String
  conversation           NadimConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdByParticipantId String?
  createdByParticipant   ConversationParticipant?    @relation("ShareTokenCreator", fields: [createdByParticipantId], references: [id], onDelete: SetNull)
  tokenHash              String                      @unique
  type                   ConversationTokenType
  permission             ConversationSharePermission @default(VIEW_AND_JOIN)
  expiresAt              DateTime
  revokedAt              DateTime?
  consumedAt             DateTime?
  maxUses                Int?
  usedCount              Int                         @default(0)
  createdAt              DateTime                    @default(now())

  @@index([conversationId, type, expiresAt])
  @@index([expiresAt, revokedAt])
}

model NadimDeletionReceipt {
  id              String   @id @default(cuid())
  channel         String
  idempotencyKey  String
  requestHash     String
  conversationId  String
  responsePayload Json
  createdAt       DateTime @default(now())

  @@unique([channel, idempotencyKey])
  @@index([conversationId, createdAt])
}

model NadimTurn {
  id              String            @id @default(cuid())
  conversationId  String
  conversation    NadimConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId       String?
  channel         String
  idempotencyKey  String?
  requestHash     String?
  responsePayload Json?
  userMessage     String
  assistantReply  String
  intent          Json
  plan            Json
  toolResults     Json
  proposedActions Json
  executedActions Json
  modelProvider   String?
  model           String?
  fallbackUsed    Boolean           @default(false)
  success         Boolean           @default(true)
  latencyMs       Int
  errorCode       String?
  createdAt       DateTime          @default(now())

  @@unique([channel, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([requestId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  toolPayload    Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ConversationState {
  id                  String       @id @default(cuid())
  conversationId      String       @unique
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  searchContext       Json
  suggestedUnitIds    String[]
  rejectedUnitIds     String[]
  likedUnitIds        String[]
  inferredPreferences Json?
  summary             Json?
  intentScore         Int          @default(0)
  updatedAt           DateTime     @updatedAt
}

model Lead {
  id                           String               @id @default(cuid())
  conversationId               String?
  conversation                 Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerId                   String?
  customer                     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name                         String?
  phone                        String?
  intent                       LeadIntent
  intentScore                  Int
  status                       LeadStatus           @default(NEW)
  payload                      Json
  source                       String               @default("WEB_AI")
  trustStatus                  String               @default("CONTACT_VALID")
  trustScore                   Int                  @default(100)
  trustReasons                 String[]             @default([])
  preferredContactChannel      String?
  preferredConfirmationChannel String?
  preferredVisitDayPart        String?
  preferredVisitTiming         String?
  contactValidatedAt           DateTime?
  assignedToAdminId            String?
  assignedTo                   AdminUser?           @relation("LeadAssignment", fields: [assignedToAdminId], references: [id], onDelete: SetNull)
  followUpAt                   DateTime?
  events                       LeadEvent[]
  notes                        LeadNote[]
  trustAlerts                  CustomerTrustAlert[]
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([assignedToAdminId, followUpAt])
  @@index([intentScore])
  @@index([trustStatus, createdAt])
  @@index([customerId, status, updatedAt])
  @@index([phone, status])
}

model CustomerTrustAlert {
  id                String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  riskLevel         String
  score             Int
  reasons           String[]     @default([])
  candidateName     String?
  candidatePhone    String?
  messagePreview    String?
  payload           Json?
  status            String       @default("OPEN")
  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolvedBy        AdminUser?   @relation("TrustAlertResolution", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([conversationId, status])
  @@index([leadId])
  @@index([candidatePhone])
}

model LeadEvent {
  id          String     @id @default(cuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  type        String
  payload     Json?
  deliveredAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([leadId, createdAt])
}

model LeadNote {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId, createdAt])
}

model AdminUser {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  passwordHash               String
  name                       String
  role                       String                      @default("ADMIN")
  active                     Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  auditLogs                  AuditLog[]
  assignedLeads              Lead[]                      @relation("LeadAssignment")
  leadNotes                  LeadNote[]
  leadEvents                 LeadEvent[]
  resolvedTrustAlerts        CustomerTrustAlert[]        @relation("TrustAlertResolution")
  imports                    DataImport[]
  importCorrections          ImportCorrection[]
  approvedKnowledgeItems     ProjectKnowledgeItem[]
  verifiedLocationDistances  LocationDistance[]
  verifiedPortfolioProjects  DeveloperProjectPortfolio[]
  verifiedInvestmentProfiles ProjectInvestmentProfile[]
  confirmedMasterPlanUnits   Unit[]                      @relation("MasterPlanUnitConfirmation")
  confirmedProjectBoundaries Project[]                   @relation("ProjectBoundaryConfirmation")
  confirmedProjectGates      ProjectGate[]               @relation("ProjectGateConfirmation")
  confirmedProjectBuildings  ProjectBuilding[]           @relation("MasterPlanBuildingConfirmation")
}

model DeveloperProjectPortfolio {
  id                String     @id @default(cuid())
  developerId       String
  developer         Developer  @relation(fields: [developerId], references: [id], onDelete: Cascade)
  projectName       String
  locationText      String?
  locationId        String?
  location          Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  projectType       String?
  status            String
  launchYear        Int?
  deliveryYear      Int?
  unitsCount        Int?
  description       String?
  source            String?
  verifiedAt        DateTime?
  verifiedByAdminId String?
  verifiedBy        AdminUser? @relation(fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([developerId, status])
  @@index([locationId])
}

model Amenity {
  id              String           @id @default(cuid())
  canonicalName   String           @unique
  nameAr          String?
  nameEn          String?
  category        String?
  description     String?
  projects        ProjectAmenity[]
  unitProximities UnitProximity[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProjectAmenity {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  notes     String?
  verified  Boolean @default(false)
  source    String?

  @@id([projectId, amenityId])
}

model ProjectInvestmentProfile {
  id                     String     @id @default(cuid())
  projectId              String     @unique
  project                Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suitableForLiving      Boolean?
  suitableForInvestment  Boolean?
  suitableForRental      Boolean?
  resaleDemand           String?
  rentalDemand           String?
  expectedRentalYieldMin Decimal?   @db.Decimal(7, 4)
  expectedRentalYieldMax Decimal?   @db.Decimal(7, 4)
  strongestUnitTypes     String[]
  targetCustomers        String[]
  investmentAdvantages   String[]
  investmentRisks        String[]
  notes                  String?
  source                 String?
  verifiedAt             DateTime?
  verifiedByAdminId      String?
  verifiedBy             AdminUser? @relation(fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

model ProjectLandmark {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  category         String?
  locationId       String?
  location         Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  distanceKm       Decimal?        @db.Decimal(8, 2)
  estimatedMinutes Int?
  distanceType     String          @default("ADMIN_VERIFIED")
  notes            String?
  source           String?
  verifiedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  unitProximities  UnitProximity[]

  @@index([projectId, category])
  @@index([locationId])
}

model ProjectCompetitor {
  projectId           String
  project             Project  @relation("CompetitorFrom", fields: [projectId], references: [id], onDelete: Cascade)
  competitorProjectId String
  competitorProject   Project  @relation("CompetitorTo", fields: [competitorProjectId], references: [id], onDelete: Cascade)
  reason              String?
  notes               String?
  verified            Boolean  @default(false)
  source              String?
  createdAt           DateTime @default(now())

  @@id([projectId, competitorProjectId])
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
}

model AIUsage {
  id             String   @id @default(cuid())
  provider       String
  model          String
  taskType       String
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int
  success        Boolean
  fallbackUsed   Boolean  @default(false)
  errorCode      String?
  promptVersion  String?
  promptVariant  String?  @default("control")
  conversationId String?
  createdAt      DateTime @default(now())

  @@index([provider, createdAt])
  @@index([taskType, createdAt])
  @@index([promptVersion, createdAt])
  @@index([conversationId])
}
