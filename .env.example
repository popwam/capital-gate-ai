# Shared runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maqar
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# AI routing (demo is allowed only in local development)
AI_PROVIDER=demo
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-120b
CLOUDFLARE_AI_FAST_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini

# Anonymous device and Admin security
DEVICE_HASH_SECRET=replace-with-at-least-32-random-bytes
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes
# Server-only, production Admin entry path. Generate with: npm run admin:path:generate
ADMIN_ACCESS_PATH=
ADMIN_COOKIE_DOMAIN=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Object storage (local is development-only; production must use r2)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: Admin geocoding and exact customer route requests
GOOGLE_MAPS_SERVER_API_KEY=
