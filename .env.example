# Shared runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maqar
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# AI (demo is development-only; production must use gemini)
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anonymous device and admin security
DEVICE_HASH_SECRET=replace-with-at-least-32-random-bytes
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes
# Optional for sibling production subdomains, for example .example.com
ADMIN_COOKIE_DOMAIN=
# One-time only: used to create the first AdminUser when the table is empty; remove after first successful boot
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Object storage (local is development-only; production must use r2)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: enables Admin geocoding and exact Routes API lookups
GOOGLE_MAPS_SERVER_API_KEY=

# FUTURE/OPTIONAL: reserved for the outbound CRM adapter, which is intentionally not active in this phase
CRM_WEBHOOK_URL=
