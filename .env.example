# Local development: copy this file to .env in the repository root.
# API and Web both load that root file; Railway should use per-service Variables instead.
# Shared runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maqar
WEB_ORIGIN=http://localhost:3000

# Nadim V2 server-to-server gateway and customer continuation links
NADIM_V2_ENABLED=false
NADIM_API_URL=http://localhost:8080
INTERNAL_API_URL=http://localhost:8080
NADIM_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
WEB_BASE_URL=http://localhost:3000
# Digits only, including country code; used as the destination of wa.me links.
WHATSAPP_BUSINESS_NUMBER=

# Verified currency conversion for non-EGP property budgets. URL may contain
# {from}/{to}, or receives from/to query parameters. Response: rate plus
# optional asOf/date and source. If omitted, Nadim preserves the original
# currency and refuses to guess an EGP conversion.
FX_API_URL=
FX_API_KEY=
FX_TIMEOUT_MS=2000
FX_CACHE_TTL_MS=900000
FX_STALE_MAX_MS=21600000

# Cg Ai production routing
# Customer answers: Groq production models -> Cloudflare Workers AI fallback.
# OpenAI is opt-in only because API usage is paid; it is not a free production fallback.
AI_PROVIDER=hybrid
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_GENERAL_MODEL=openai/gpt-oss-120b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_BACKUP_MODEL=openai/gpt-oss-20b
GROQ_LAST_RESORT_MODEL=openai/gpt-oss-20b
ALLOW_PREVIEW_GROQ_MODELS=false
ALLOW_UNLISTED_GROQ_MODELS=false
OPENAI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=

# Workers AI: intent extraction + resilient response fallback
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-120b
CLOUDFLARE_AI_FAST_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Nadim V2 primary dialogue provider. When disabled or unavailable, V2 uses
# GroqDialogueProvider as its secondary provider.
BEDROCK_GLM_ENABLED=false
BEDROCK_API_KEY=
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_GLM_MODEL=zai.glm-5

# Deterministic external action execution. Leave disabled until the separate
# Automation API is deployed, reachable, and protected by the same secret.
NADIM_ACTION_EXECUTION_ENABLED=false
NADIM_AUTOMATION_API_URL=http://localhost:8081
NADIM_AUTOMATION_SECRET=replace-with-at-least-32-random-bytes
NADIM_DEFAULT_PHONE_COUNTRY=EG

# Anonymous device and Admin security
DEVICE_HASH_SECRET=replace-with-at-least-32-random-bytes
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_ACCESS_PATH=
ADMIN_COOKIE_DOMAIN=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Object storage (local is development-only; production should use r2)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Maps
# Keep this server key secret for geocoding/routes.
GOOGLE_MAPS_SERVER_API_KEY=
# Separate browser key restricted by Website / HTTP referrers.
# In its Google Cloud project enable Maps JavaScript API. Do not reuse the server key here.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
